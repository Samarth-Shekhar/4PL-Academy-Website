{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema/runtime.js"
  },
  "scripts": {
    "dump:mysql": "node src/scripts/dump-mysql.js",
    "test": "node --test src/settings.test.js src/compatibility.test.js",
    "test:integration": "node src/integration.test.js",
    "push": "drizzle-kit push --config ./drizzle.config.js",
    "generate": "drizzle-kit generate --config ./drizzle.config.js",
    "migrate": "drizzle-kit migrate --config ./drizzle.config.js"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
