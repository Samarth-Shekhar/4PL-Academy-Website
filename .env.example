# Non-secret configuration template. Never commit an actual .env file.
# On Replit, use environment configuration and Secrets for real credentials.
# The API loads a local .env at startup; restart after changing settings.

# Choose postgresql (default) or mysql. This does NOT migrate/copy data.
DB_DIALECT=postgresql
DB_POOL_SIZE=10

# OPTION A: a connection URL, stored securely, for the selected dialect.
# DB_CONNECTION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DB_CONNECTION_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# With PostgreSQL and no custom config, Replit's managed DATABASE_URL is used.
# MySQL NEVER falls back to Replit's managed PostgreSQL DATABASE_URL.

# OPTION B: individual connection settings instead of DB_CONNECTION_URL.
# DB_HOST=YOUR_DATABASE_HOST
# DB_PORT=5432
# DB_NAME=YOUR_DATABASE_NAME
# DB_USER=YOUR_DATABASE_USER
# DB_PASSWORD=YOUR_DATABASE_PASSWORD
# PostgreSQL's default port is 5432; MySQL's is 3306.

# Enable verified TLS for a remote database. Leave unset to use URL settings.
# Do not disable TLS on a remote production database.
# DB_SSL=true

# Other existing required application secrets are unchanged:
# SESSION_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
# MICROSOFT_TENANT_ID, MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET
