{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/api-server run local",
    "build": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/academy run build",
    "start": "NODE_ENV=production pnpm --filter @workspace/api-server run start",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:seed": "pnpm --filter @workspace/api-server run seed",
    "check": "node scripts/check-javascript.mjs",
    "typecheck:libs": "node scripts/check-javascript.mjs",
    "typecheck": "pnpm run check"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
